  "grammar": [
    {"id":"g1-predicate-final","pattern":"S + O + P","name":"Predicate-final sentence order","meaning":"The predicate comes at the end of a basic Korean sentence.","formation":["nominal elements + predicate"],"usage":["basic Korean word order"],"examples":[{"ko":"영미가 저녁을 먹어요.","en":"Youngmi eats dinner."}],"commonMistakes":["Do not assume English SVO order; Korean predicates normally close the clause."],"tags":["sentence-structure"],"sourceRefs":[{"file":"lesson1.pptx","slides":[10,11]}]},
    {"id":"g1-topic","pattern":"N은/는","name":"Topic particle","meaning":"Marks the topic being introduced or contrasted.","formation":["consonant-ending noun + 은","vowel-ending noun + 는"],"usage":["introducing a topic","contrast"],"examples":[{"ko":"저는 폴이에요.","en":"As for me, I am Paul."},{"ko":"선생님은 한국 사람이에요.","en":"The teacher is Korean."}],"related":["g1-also","g1-subject"],"tags":["particle","topic"],"sourceRefs":[{"file":"lesson1.pptx","slides":[12,17]}]},
    {"id":"g1-copula","pattern":"N이에요/예요","name":"Polite copula","meaning":"Links a noun to an identity or category: ‘is/am/are N.’","formation":["after consonant: 이에요","after vowel: 예요"],"examples":[{"ko":"저는 마이클 정이에요.","en":"I am Michael Jung."},{"ko":"저는 김유미예요.","en":"I am Kim Yumi."}],"tags":["copula","identity"],"sourceRefs":[{"file":"lesson1.pptx","slide":14}]},
    {"id":"g1-also","pattern":"N도","name":"Particle 도","meaning":"Adds the meaning ‘also/too.’","formation":["noun + 도"],"examples":[{"ko":"저도 학생이에요.","en":"I am a student too."}],"contrast":[{"with":"은/는","note":"The PPT contrasts 은/는 with 도 when showing difference/parallel information."}],"tags":["particle","addition"],"sourceRefs":[{"file":"lesson1.pptx","slides":[16,17]}]},
    {"id":"g1-subject","pattern":"N이/가","name":"Subject particle","meaning":"Marks a grammatical subject or focused noun.","formation":["consonant-ending noun + 이","vowel-ending noun + 가"],"examples":[{"ko":"이름이 뭐예요?","en":"What is your name?"},{"ko":"마크 씨가 미국 사람이에요?","en":"Is Mark American?"}],"related":["g1-topic"],"tags":["particle","subject"],"sourceRefs":[{"file":"lesson1.pptx","slide":30}]},
    {"id":"g1-noun-negation","pattern":"N이/가 아니에요","name":"Noun negation","meaning":"Says that someone or something is not N.","formation":["noun + 이/가 + 아니에요"],"examples":[{"ko":"한국 사람이 아니에요.","en":"I am not Korean."},{"ko":"선생님이 아니에요.","en":"(They) are not a teacher."}],"contrast":[{"with":"N이에요/예요","note":"이에요/예요 identifies; 아니에요 negates noun identity/category."}],"tags":["negation","copula"],"sourceRefs":[{"file":"lesson1.pptx","slides":[41,42,43]}]},
