  "grammar": [
    {"id":"g6-range","pattern":"A에서 B까지","name":"From A to B","meaning":"Marks a starting point with 에서 and an endpoint with 까지.","examples":[{"ko":"집에서 학교까지 얼마나 걸려요?","en":"How long does it take from home to school?"}],"tags":["particle","distance","range"],"sourceRefs":[{"file":"lesson6(ST).pptx","slides":[10,11,12]}]},
    {"id":"g6-duration","pattern":"duration + 걸려요","name":"Time duration with 걸리다","meaning":"Says how much time an activity or trip takes.","examples":[{"ko":"10분 걸려요.","en":"It takes 10 minutes."},{"ko":"차로 한 시간쯤 걸려요.","en":"It takes about an hour by car."}],"tags":["time","duration"],"sourceRefs":[{"file":"lesson6(ST).pptx","slides":[12,13,20,23]}]},
    {"id":"g6-means","pattern":"N(으)로","name":"Means of transportation / instrument","meaning":"Marks the means, vehicle, language, or instrument used for an action.","formation":["noun + (으)로"],"examples":[{"ko":"택시로 가요.","en":"I go by taxi."},{"ko":"한국어로 말해요.","en":"I speak in Korean."},{"ko":"볼펜으로 쓰세요.","en":"Please write with a ballpoint pen."}],"commonMistakes":["The PPT separately highlights 걸어서 for going on foot."],"tags":["particle","means","instrument"],"sourceRefs":[{"file":"lesson6(ST).pptx","slides":[16,17,18,19]}]},
    {"id":"g6-b-irregular","pattern":"ㅂ → 우/오 before some vowel endings","name":"ㅂ-irregular adjectives","meaning":"Some ㅂ-final stems change before vowel-initial endings.","examples":[{"ko":"춥다 → 추워요","en":"cold → is cold"},{"ko":"덥다 → 더워요","en":"hot → is hot"},{"ko":"쉽다 → 쉬워요","en":"easy → is easy"},{"ko":"가깝다 → 가까워요","en":"near → is near"}],"contrast":[{"with":"좁다 / 넓다","note":"The PPT marks 좁아요/넓어요 as exceptions to the illustrated irregular pattern."}],"tags":["irregular","conjugation"],"sourceRefs":[{"file":"lesson6(ST).pptx","slides":[24,25,26,27]}]},
    {"id":"g6-past","pattern":"-았/었어요; 하다 → 했어요","name":"Polite past tense","meaning":"Forms a polite past/completed predicate.","formation":["ㅏ/ㅗ stems → -았어요","most other vowels → -었어요","하다 → 했어요"],"examples":[{"ko":"학교 수영장에서 수영했어요.","en":"I swam at the school pool."},{"ko":"친구하고 같이 테니스 쳤어요.","en":"I played tennis with a friend."}],"tags":["past","tense"],"sourceRefs":[{"file":"lesson6(ST).pptx","slides":[31,33,34,35]}]},
    {"id":"g6-short-negation","pattern":"안 + A/V","name":"Short negation with 안","meaning":"Negates a verb or adjective with 안 placed before the predicate.","examples":[{"ko":"안 가요.","en":"I do not go."},{"ko":"안 좋아요.","en":"It is not good / I do not like it, depending on context."}],"commonMistakes":["With many N+하다 verbs, the PPT highlights placing 안 before 하다 rather than before the noun portion."],"tags":["negation"],"sourceRefs":[{"file":"lesson6(ST).pptx","slides":[48,49,50,51]}]},
    {"id":"g6-cannot","pattern":"못 + action verb","name":"Inability with 못","meaning":"Expresses inability or failure to carry out an action.","examples":[{"ko":"못 가요.","en":"I cannot go."},{"ko":"수영 못 해요.","en":"I cannot swim."}],"contrast":[{"with":"안","note":"안 is simple negation; 못 expresses inability with action verbs in this lesson."}],"tags":["negation","inability"],"sourceRefs":[{"file":"lesson6(ST).pptx","slides":[53,54]}]}
