  "grammar": [
    {"id":"g7-future","pattern":"V-(으)ㄹ 거예요","name":"Future plan / intention","meaning":"Expresses a future plan or intention.","formation":["vowel-ending stem + ㄹ 거예요","consonant-ending stem + 을 거예요"],"examples":[{"ko":"친구하고 영화를 볼 거예요.","en":"I’m going to watch a movie with a friend."},{"ko":"하와이에 갈 거예요.","en":"I’m going to go to Hawai‘i."}],"tags":["future","plan"],"sourceRefs":[{"file":"lesson 7.pptx","slides":[16,18,27,30]}]},
    {"id":"g7-probability","pattern":"A/V-(으)ㄹ 거예요","name":"Probability / probable future","meaning":"Can express a prediction or probability about a future situation.","examples":[{"ko":"아마 내일 추울 거예요.","en":"It will probably be cold tomorrow."},{"ko":"오전에는 사람이 없을 거예요.","en":"There probably won’t be many people in the morning."}],"contrast":[{"with":"present tense for scheduled future","note":"The PPT notes that a scheduled event can be expressed in present tense, e.g. 다음 월요일에 시험이 있어요."}],"tags":["future","probability"],"sourceRefs":[{"file":"lesson 7.pptx","slides":[19,20,25]}]},
    {"id":"g7-l-irregular","pattern":"ㄹ stem omission before ㄹ/으 and certain ㄴ/ㅂ/ㅅ environments","name":"ㄹ-irregular / ㄹ omission","meaning":"The teacher PPT groups several environments where final ㄹ is omitted rather than doubled or followed by 으.","examples":[{"ko":"살다 → 살 거예요","en":"to live → will live"},{"ko":"살다 → 살까요?","en":"to live → shall we live?/will it live? depending on context"}],"tags":["irregular","conjugation"],"sourceRefs":[{"file":"lesson 7.pptx","slides":[22,23,24]}]},
    {"id":"g7-question-determiners","pattern":"무슨 N vs 어느 N","name":"What kind vs which","meaning":"무슨 asks generally what kind/type; 어느 selects among limited or identifiable candidates.","examples":[{"ko":"무슨 영화 봤어요?","en":"What kind of movie did you watch?"},{"ko":"어느 극장에서 봤어요?","en":"Which theater did you see it at?"}],"commonMistakes":["The PPT states that 어느 can occur with 것/거, but 무슨 것/거 is not used in this pattern."],"tags":["question","determiner"],"sourceRefs":[{"file":"lesson 7.pptx","slides":[37,38,43,46]}]},
    {"id":"g7-go","pattern":"A/V-고","name":"Clausal connective -고","meaning":"Connects two predicates in one sentence with an ‘and/then’ relationship.","examples":[{"ko":"날씨가 춥고 흐려요.","en":"The weather is cold and cloudy."},{"ko":"공부하고 잤어요.","en":"I studied and slept."}],"contrast":[{"with":"그리고","note":"그리고 connects sentences; -고 connects predicates/clauses within one sentence."},{"with":"하고","note":"하고 connects nouns; -고 connects predicates."}],"tags":["connector"],"sourceRefs":[{"file":"lesson 7.pptx","slides":[56,57,58,59,60,70,71]}]},
    {"id":"g7-negative-question","pattern":"안/못 ... ? / N이/가 아니에요?","name":"Negative questions","meaning":"Asks a question in negative form; interpretation of yes/no depends on whether the responder agrees with the negative proposition.","examples":[{"ko":"안 추워요?","en":"Isn’t it cold?"},{"ko":"숙제가 안 쉬워요?","en":"Isn’t the homework easy?"}],"tags":["negation","question","pragmatics"],"sourceRefs":[{"file":"lesson 7.pptx","slides":[72,73,74,75]}]}
