  "grammar": [
    {"id":"g2-predicate","pattern":"stem + ending","name":"Korean predicate conjugation","meaning":"Korean verbs and adjectives appear with endings rather than standing alone in dictionary form.","examples":[{"ko":"영미가 저녁을 먹어요.","en":"Youngmi eats dinner."},{"ko":"비빔밥이 맛있어요.","en":"Bibimbap is delicious."}],"commonMistakes":["Do not insert an extra form of ‘to be’ before Korean adjectives."],"tags":["conjugation","predicate"],"sourceRefs":[{"file":"lesson 2.pptx","slides":[3,4,5]}]},
    {"id":"g2-present","pattern":"-아요/어요; 하다 → 해요","name":"Polite present style","meaning":"Forms a common polite present/non-past predicate ending.","formation":["stem with ㅏ/ㅗ → -아요","most other vowels → -어요","하다 → 해요"],"examples":[{"ko":"먹어요.","en":"(I/you/they) eat."},{"ko":"알아요.","en":"(I/you/they) know."},{"ko":"공부해요.","en":"(I/you/they) study."}],"tags":["present","polite","conjugation"],"sourceRefs":[{"file":"lesson 2.pptx","slides":[15,16,17,19]}]},
    {"id":"g2-surface-changes","pattern":"vowel deletion / contraction","name":"Common present-tense contractions","meaning":"Some stem + ending combinations reduce or contract in the surface form.","formation":["만나다 + 아요 → 만나요","보다 + 아요 → 봐요","마시다 + 어요 → 마셔요","크다 + 어요 → 커요"],"examples":[{"ko":"친구를 만나요.","en":"I meet a friend."},{"ko":"텔레비전을 봐요.","en":"I watch TV."},{"ko":"커피를 마셔요.","en":"I drink coffee."}],"commonMistakes":["Do not mechanically keep every vowel when the teacher pattern shows deletion or contraction."],"tags":["conjugation","contraction"],"sourceRefs":[{"file":"lesson 2.pptx","slides":[21,22,23,24,25,26]}]},
    {"id":"g2-object","pattern":"N을/를 + V","name":"Object particles","meaning":"Marks the direct object of an action verb.","formation":["consonant-ending noun + 을","vowel-ending noun + 를"],"examples":[{"ko":"한국어를 공부해요.","en":"I study Korean."},{"ko":"텔레비전을 봐요.","en":"I watch television."}],"tags":["particle","object"],"sourceRefs":[{"file":"lesson 2.pptx","slides":[30,31,32]}]},
    {"id":"g2-what-do","pattern":"뭐 해요?","name":"Ask what someone is doing","meaning":"A compact everyday question asking what someone does/is doing.","examples":[{"ko":"뭐 해요? 공부해요.","en":"What are you doing? I’m studying."}],"tags":["question","daily-life"],"sourceRefs":[{"file":"lesson 2.pptx","slides":[33,34]}]},
    {"id":"g2-opinion","pattern":"N이/가 어때요?","name":"Ask for an opinion or description","meaning":"Asks ‘How is N?’ or ‘What is N like?’","examples":[{"ko":"비빔밥이 어때요? 맛있어요.","en":"How is the bibimbap? It’s delicious."},{"ko":"한국어 수업이 어때요? 아주 재미있어요.","en":"How is Korean class? It’s very interesting."}],"tags":["question","description"],"sourceRefs":[{"file":"lesson 2.pptx","slides":[51,52,54,56]}]},
    {"id":"g2-checkin","pattern":"요즘 어떻게 지내요?","name":"Everyday check-in","meaning":"A polite way to ask how someone has been doing lately.","examples":[{"ko":"요즘 어떻게 지내요? 잘 지내요.","en":"How have you been lately? I’m doing well."}],"tags":["expression","daily-life"],"sourceRefs":[{"file":"lesson 2.pptx","slides":[58,59]}]},
