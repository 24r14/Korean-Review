  "grammar": [
    {"id":"g9-dates","pattern":"YYYY년 M월 D일","name":"Korean dates","meaning":"Dates use Sino-Korean numbers and are ordered from larger to smaller units: year → month → day.","examples":[{"ko":"2024년 2월 16일이에요.","en":"It is February 16, 2024."},{"ko":"오늘은 며칠이에요?","en":"What day of the month is it today?"}],"commonMistakes":["June and October are conventionally 유월 and 시월 rather than 육월 and 십월 in the teacher materials."],"tags":["numbers","date"],"sourceRefs":[{"file":"lesson 9(ST).pptx","slides":[8,9,10,11,12,13,14,15]}]},
    {"id":"g9-age","pattern":"Native Korean number + 살","name":"Age with Native Korean numbers","meaning":"Age is expressed with Native Korean numbers plus 살 in this lesson.","examples":[{"ko":"몇 살이에요?","en":"How old are you?"},{"ko":"올해 일흔 다섯이세요.","en":"She is seventy-five this year."}],"tags":["numbers","age"],"sourceRefs":[{"file":"lesson 9(ST).pptx","slides":[16,17,18,19,20,58]}]},
    {"id":"g9-recipient-source","pattern":"Place 에/에서; Person 한테/한테서/께","name":"Goal/source for places and people","meaning":"에 marks a place goal; 에서 marks a place source. 한테 marks a person recipient/goal, 한테서 a person source; 께 is the honorific recipient form shown by the teacher.","examples":[{"ko":"학교에 갔어요.","en":"I went to school."},{"ko":"한국에서 편지가 왔어요.","en":"A letter came from Korea."},{"ko":"리사한테 꽃과 카드를 줬어요.","en":"I gave Lisa flowers and a card."},{"ko":"마이클한테서 받았어요.","en":"I received it from Michael."}],"tags":["particle","giving","source-goal"],"sourceRefs":[{"file":"lesson 9(ST).pptx","slides":[21,22,23,24,25,26,27,28,29,31,32]}]},
    {"id":"g9-adj-modifier","pattern":"A-(으)ㄴ + N","name":"Adjective noun-modifying form","meaning":"Places a descriptive adjective before a noun in a noun-modifying form.","formation":["consonant-ending adjective stem + 은","vowel-ending stem + ㄴ","있다/없다-family adjectives take -는 in the teacher lesson"],"examples":[{"ko":"좋은 가방","en":"a good bag"},{"ko":"큰 옷","en":"big clothes"},{"ko":"재미있는 드라마","en":"an interesting drama"}],"tags":["noun-modifier","adjective"],"sourceRefs":[{"file":"lesson 9(ST).pptx","slides":[36,37,38,40,41]}]},
    {"id":"g9-adj-irregular","pattern":"ㅂ/ㄹ irregular adjective modifiers","name":"Irregular adjective modifiers","meaning":"Selected irregular stems change when adjective noun modifiers are formed.","examples":[{"ko":"어렵다 → 어려운 시험","en":"difficult → a difficult exam"},{"ko":"길다 → 긴 머리","en":"long → long hair"},{"ko":"멀다 → 먼 길","en":"far → a long/far road"}],"tags":["noun-modifier","irregular"],"sourceRefs":[{"file":"lesson 9(ST).pptx","slides":[37,38,39]}]},
    {"id":"g9-honorific-system","pattern":"honorific noun/verb/particle forms","name":"Honorific expressions","meaning":"Korean can honor a respected referent through special vocabulary, particles, counters, and subject-honorific forms.","examples":[{"ko":"할머니께 무슨 선물 드렸어요?","en":"What gift did you give your grandmother?"},{"ko":"할머니께서 아주 좋아하셨어요.","en":"Grandmother liked it very much."},{"ko":"할머니 연세가 어떻게 되세요?","en":"How old is your grandmother?"}],"tags":["honorific","pragmatics"],"sourceRefs":[{"file":"lesson 9(ST).pptx","slides":[6,57,58]},{"file":"KBL honorifics mini lesson(ST).pptx","notes":"honorific verbs/nouns/particles"}]},
    {"id":"g9-jiman","pattern":"A/V-지만; N이지만","name":"Clausal connective -지만","meaning":"Connects contrasting clauses with ‘but/although.’","examples":[{"ko":"저는 대학생이지만 제 동생은 고등학생이에요.","en":"I am a college student, but my younger sibling is a high-school student."},{"ko":"생일 파티에는 못 갔지만 선물은 샀어요.","en":"I couldn’t go to the birthday party, but I bought a gift."}],"commonMistakes":["The PPT contrasts -고 and -지만: with -지만, tense is marked in the relevant clause when the event is past."],"tags":["connector","contrast"],"sourceRefs":[{"file":"lesson 9(ST).pptx","slides":[59,60,61,62,63,64,65]}]}
