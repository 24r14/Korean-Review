    {"id":"g4-alternative","pattern":"Choice 1 ..., Choice 2 ...?","name":"Alternative questions","meaning":"Asks the listener to choose between explicit alternatives.","examples":[{"ko":"동생이 있어요, 없어요?","en":"Do you have a younger sibling or not?"},{"ko":"소피아는 일본 사람이에요, 중국 사람이에요?","en":"Is Sophia Japanese or Chinese?"}],"tags":["question"],"sourceRefs":[{"file":"lesson4(ST).pptx","slides":[28,29]}]},
    {"id":"g4-noun-and","pattern":"N와/과, N(이)랑, N하고","name":"Noun coordination","meaning":"Connects nouns with the meaning ‘and/with.’","formation":["vowel-ending noun + 와/랑","consonant-ending noun + 과/이랑","하고 works after either"],"examples":[{"ko":"의자와 책상","en":"a chair and a desk"},{"ko":"동생하고 저","en":"my younger sibling and me"}],"tags":["particle","coordination"],"sourceRefs":[{"file":"lesson4(ST).pptx","slide":35}]},
    {"id":"g4-numbers","pattern":"Native Korean vs Sino-Korean numbers","name":"Two number systems","meaning":"Korean uses two number systems for different functions; this lesson reviews both and applies them to prices, dates, quantities, and counters.","examples":[{"ko":"오백팔십 원","en":"580 won"},{"ko":"2024년 6월 30일","en":"June 30, 2024"}],"tags":["numbers"],"sourceRefs":[{"file":"lesson4(ST).pptx","slides":[37,38,39,40,46,47,48,55,56]}]},
    {"id":"g4-counters","pattern":"N + number + counter","name":"Noun counters","meaning":"Counted nouns use classifiers/counters such as 개, 명, 마리, and 권.","formation":["하나→한, 둘→두, 셋→세, 넷→네, 스물→스무 before counters","noun + number + counter","noun + particle + number + counter + 있다"],"examples":[{"ko":"교과서 두 권","en":"two textbooks"},{"ko":"친구가 세 명 있어요.","en":"I have three friends."}],"tags":["numbers","counter"],"sourceRefs":[{"file":"lesson4(ST).pptx","slides":[57,65,66,67,68,69,70,73,74,75]}]},
    {"id":"g4-possessive","pattern":"N1(의) N2 / N1 거","name":"Possessive relations","meaning":"Places the possessor before the possessed noun; 의 is often omitted in conversation. 거/것 can replace an understood possessed object.","formation":["possessor + (의) + possessed","나+의→내","저+의→제","possessor + 거"],"examples":[{"ko":"마이클 책","en":"Michael’s book"},{"ko":"제 거예요.","en":"It’s mine."},{"ko":"누구 거예요?","en":"Whose is it?"}],"commonMistakes":["The PPT notes that possessive 의 is usually pronounced [에] and is often dropped in conversation."],"tags":["possession","particle"],"sourceRefs":[{"file":"lesson4(ST).pptx","slides":[86,88,90,93,94,95,96,99,102]}]},
    {"id":"g4-vowel-contraction","pattern":"vowel + -아/어요 → contracted form","name":"Vowel contraction","meaning":"When vowels meet during conjugation, Korean often merges, deletes, or contracts them.","formation":["가+아요→가요","마시+어요→마셔요","주+어요→줘요","오+아요→와요","크+어요→커요","예쁘+어요→예뻐요"],"examples":[{"ko":"내일 형이 와요.","en":"My older brother comes tomorrow."},{"ko":"시계가 예뻐요.","en":"The watch is pretty."}],"tags":["conjugation"],"sourceRefs":[{"file":"lesson4(ST).pptx","slides":[114,118,119,120,121,122,123,125,127]}]}
