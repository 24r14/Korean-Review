  "grammar": [
    {"id":"g5-location","pattern":"에 vs 에서","name":"Location particles","meaning":"에 marks static existence or a destination/goal; 에서 marks the location where an action happens.","formation":["static location: place + 에 + 있다/계시다","destination: place + 에 + 가다/오다","activity location: place + 에서 + action verb"],"examples":[{"ko":"도서관에 있어요.","en":"I am in the library."},{"ko":"도서관에 가요.","en":"I go to the library."},{"ko":"도서관에서 공부해요.","en":"I study at the library."}],"tags":["particle","location"],"sourceRefs":[{"file":"lesson5(ST).pptx","slides":[22,23,24,26]}]},
    {"id":"g5-time-particle","pattern":"time + 에","name":"Time particle 에","meaning":"Marks many specific times, dates, and scheduled points in time.","examples":[{"ko":"월요일에 영화를 봐요.","en":"I watch a movie on Monday."},{"ko":"3시에 만나요.","en":"Let’s meet at 3."}],"commonMistakes":["The PPT states that 어제, 오늘, and 내일 do not take 에 in this use."],"tags":["time","particle"],"sourceRefs":[{"file":"lesson5(ST).pptx","slides":[15,16,54]}]},
    {"id":"g5-sentence-pattern","pattern":"S + location + O + V","name":"Basic sentence pattern","meaning":"Korean is predicate-final; nominal elements can move, but the predicate stays at the end.","formation":["N이/가 + N에서 + N을/를 + V-아/어요"],"examples":[{"ko":"유미가 교실에서 한국어를 공부해요.","en":"Yumi studies Korean in the classroom."}],"tags":["sentence-structure"],"sourceRefs":[{"file":"lesson5(ST).pptx","slides":[46,47]}]},
    {"id":"g5-clock-time","pattern":"Native Korean + 시; Sino-Korean + 분","name":"Clock time","meaning":"Hours use Native Korean numbers and minutes use Sino-Korean numbers.","examples":[{"ko":"한 시 삼십 분","en":"1:30"},{"ko":"한 시 반","en":"1:30 (one-thirty / half past one)"}],"tags":["numbers","time"],"sourceRefs":[{"file":"lesson5(ST).pptx","slides":[51,52,53]}]},
    {"id":"g5-purpose","pattern":"V-(으)러 [place]에 가다/오다","name":"Purpose of motion","meaning":"Explains the purpose for going or coming somewhere.","formation":["consonant-ending stem + 으러","vowel-ending stem + 러"],"examples":[{"ko":"공부하러 도서관에 가요.","en":"I go to the library to study."},{"ko":"점심 먹으러 식당에 가요.","en":"I go to a restaurant to eat lunch."}],"tags":["purpose","motion"],"sourceRefs":[{"file":"lesson5(ST).pptx","slides":[62,63,64]}]},
    {"id":"g5-d-irregular","pattern":"ㄷ → ㄹ before vowel-initial endings","name":"ㄷ-irregular verbs","meaning":"Some ㄷ-final verb stems change ㄷ to ㄹ before a vowel-initial ending.","examples":[{"ko":"듣다 → 들어요 / 들으세요","en":"listen → listen (polite) / please listen"},{"ko":"걷다 → 걸어요 / 걸으세요","en":"walk → walk (polite) / please walk"}],"tags":["irregular","conjugation"],"sourceRefs":[{"file":"lesson5(ST).pptx","slides":[82,83,84]}]}
  ],
