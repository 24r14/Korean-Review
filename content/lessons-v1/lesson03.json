  "grammar": [
    {"id":"g3-location","pattern":"[place]에 있어요/없어요","name":"Existence at a location","meaning":"States where a person or thing exists or does not exist.","formation":["place + 에 + 있다/없다"],"examples":[{"ko":"학교가 먼시에 있어요.","en":"The school is in Muncie."},{"ko":"학생회관에 있어요.","en":"It is in the student center."}],"commonMistakes":["For this existence pattern, the PPT uses 에 as the location particle."],"tags":["location","existence","particle"],"sourceRefs":[{"file":"lesson3.pptx","slides":[9,10,16,20,31,40]}]},
    {"id":"g3-topic-shift","pattern":"N은/는 ... / N은요?·는요?","name":"Changing the topic","meaning":"Uses 은/는 to move the conversation to a new topic; N은요?/는요? can mean ‘What about N?’","examples":[{"ko":"기숙사는 어디 있어요?","en":"What about the dormitory—where is it?"},{"ko":"서점은요?","en":"What about the bookstore?"}],"contrast":[{"with":"g1-topic","note":"Lesson 3 extends the Lesson 1 topic/contrast particle into conversation-level topic shifting."}],"tags":["topic","discourse","particle"],"sourceRefs":[{"file":"lesson3.pptx","slides":[29,30]}]},
    {"id":"g3-possession","pattern":"N이/가 있어요/없어요","name":"Possession with 있다/없다","meaning":"Expresses having or not having something.","formation":["possessed noun + 이/가 + 있어요/없어요"],"examples":[{"ko":"질문이 있어요.","en":"I have a question."},{"ko":"영어 사전이 없어요.","en":"I do not have an English dictionary."}],"contrast":[{"with":"g3-location","note":"Possession uses N이/가 + 있다/없다, while existence uses [place]에 + 있다/없다."}],"tags":["possession","existence"],"sourceRefs":[{"file":"lesson3.pptx","slides":[37,38,39,40]}]},
    {"id":"g3-who","pattern":"누구 → 누가 before 가","name":"Who as subject","meaning":"누구 asks ‘who’; when followed by subject particle 가, the form appears as 누가.","examples":[{"ko":"리사가 누구예요?","en":"Who is Lisa?"},{"ko":"누가 한국어 선생님이에요?","en":"Who is the Korean teacher?"}],"tags":["question","subject"],"sourceRefs":[{"file":"lesson3.pptx","slides":[41,42,43,44]}]},
    {"id":"g3-connectors","pattern":"그리고 / 그런데 / 그래서","name":"Sentence connectors","meaning":"Connects whole sentences as addition, contrast/topic shift, or result.","formation":["그리고 = and","그런데 = but/by the way","그래서 = so/therefore"],"examples":[{"ko":"오늘은 수업이 없어요. 그래서 친구를 만나요.","en":"There is no class today, so I meet a friend."}],"tags":["connector","discourse"],"sourceRefs":[{"file":"lesson3.pptx","slides":[45,46,47,48]}]},
    {"id":"g3-honorific","pattern":"-(으)세요 = -(으)시- + -어요","name":"Honorific polite ending","meaning":"Adds respect toward the honored subject/listener in a polite sentence.","formation":["after consonant stem: -으세요","after vowel stem: -세요"],"examples":[{"ko":"한국어 반 선생님이 누구세요?","en":"Who is the Korean-class teacher?"},{"ko":"사장님, 오늘 뭐 하세요?","en":"Boss/manager, what are you doing today?"}],"commonMistakes":["Politeness and honorific marking are related but not identical; the PPT explicitly derives -세요 from -(으)시- + -어요."],"tags":["honorific","polite","speech-level"],"sourceRefs":[{"file":"lesson3.pptx","slides":[53,54,56,57,58,59,60,63,64,65,70]}]},
    {"id":"g3-honorific-exist","pattern":"있다 → 있으세요 / 계세요","name":"Honorific forms of 있다","meaning":"The PPT distinguishes honorific possession and honorific existence.","formation":["possession: 있다 → 있으세요","existence: 있다 → 계세요"],"examples":[{"ko":"선생님, 책이 있으세요?","en":"Teacher, do you have a book?"},{"ko":"선생님이 집에 계세요.","en":"The teacher is at home."}],"tags":["honorific","possession","existence"],"sourceRefs":[{"file":"lesson3.pptx","slide":66}]}
  ],
