  "lesson": {
    "id": "lesson-3",
    "number": 3,
    "titleKo": "위치와 교실 표현",
    "titleEn": "Locations and Classroom Korean",
    "theme": "Campus locations, existence/possession, topic shifting, connectors, and introductory honorifics",
    "situations": [
      "asking where a place or object is",
      "describing relative position",
      "saying what you have or do not have",
      "shifting topics in conversation",
      "speaking respectfully to or about a teacher"
    ],
    "goals": [
      "Use [place]에 있어요/없어요 for existence",
      "Use N이/가 있어요/없어요 for possession",
      "Use location nouns such as 앞, 뒤, 옆, 위, 아래, 안, 밖",
      "Use 은/는 and 은요?/는요? to shift the topic",
      "Use 누구/누가 in basic identity questions",
      "Use 그리고, 그런데, 그래서 to connect discourse",
      "Recognize and form the honorific ending -(으)세요"
    ],
    "teacherFocus": [
      "campus and classroom place vocabulary",
      "distinction between existence and possession with 있다/없다",
      "topic-shifting use of 은/는",
      "honorific suffix -(으)시- and polite honorific ending -(으)세요",
      "honorific 있다 forms: 있으세요 for possession and 계세요 for existence"
    ],
    "connections": ["sentence-particles", "speech-honorifics", "connectors", "real-life"],
